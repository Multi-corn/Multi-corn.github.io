// 同类型找牌
function findSameType(hand, lastInfo) {
    const type = lastInfo.type;
    const level = lastInfo.level;
    const normals = hand.filter(c => !isWild(c));
    const wilds = hand.filter(isWild);

    if (type === 'single') {
        for (const c of hand) {
            const info = identify([c]);
            if (info && info.level > level) return [c];
        }
        return null;
    }
    if (type === 'pair') {
        // 找对子
        const byRank = groupByRank(normals);
        for (const rank in byRank) {
            if (byRank[rank].length >= 2) {
                const cards = byRank[rank].slice(0, 2);
                const info = identify(cards);
                if (info && info.level > level) return cards;
            }
        }
        // 用逢人配
        if (wilds.length >= 1) {
            for (const rank in byRank) {
                if (byRank[rank].length >= 1) {
                    const cards = [byRank[rank][0], wilds[0]];
                    const info = identify(cards);
                    if (info && info.level > level) return cards;
                }
            }
        }
        return null;
    }
    if (type === 'triple') {
        const byRank = groupByRank(normals);
        for (const rank in byRank) {
            if (byRank[rank].length >= 3) {
                const cards = byRank[rank].slice(0, 3);
                const info = identify(cards);
                if (info && info.level > level) return cards;
            }
        }
        return null;
    }
    if (type === 'triple_pair') {
        // 简化：从手牌找三张 + 一对
        const byRank = groupByRank(normals);
        for (const r3 in byRank) {
            if (byRank[r3].length >= 3) {
                for (const r2 in byRank) {
                    if (r2 === r3) continue;
                    if (byRank[r2].length >= 2) {
                        const cards = [...byRank[r3].slice(0,3), ...byRank[r2].slice(0,2)];
                        const info = identify(cards);
                        if (info && info.type === 'triple_pair' && info.level > level) return cards;
                    }
                }
            }
        }
        return null;
    }
    if (type === 'straight') {
        // 简化：从手牌找顺子
        return findStraight(hand, level);
    }
    if (type === 'pair_straight') {
        return findPairStraight(hand, level);
    }
    if (type === 'plate') {
        return findPlate(hand, level);
    }
    return null;
}

function groupByRank(cards) {
    const g = {};
    for (const c of cards) {
        if (c.suit === 'JOKER') continue;
        if (!g[c.rank]) g[c.rank] = [];
        g[c.rank].push(c);
    }
    return g;
}

